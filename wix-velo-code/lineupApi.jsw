// Place this file at: Backend > lineupApi.jsw in the Velo editor
// ============================================================

import wixData from 'wix-data';

/**
 * Fetch all lineup items from the "Lineup" CMS collection.
 * Returns an array of artist objects formatted for the Custom Element.
 * 
 * CMS field IDs (from your Wix Content Manager):
 *   - title          → "Name" column (Artist name)
 *   - id             → "Kezdő idő" column (Date/Time: set start time)
 *   - id1            → "Vége idő" column (Date/Time: set end time)
 *   - sznpad         → "Színpad" column (Tags/Reference: stage name)
 *   - genre1         → "Genre" column (Text: music genre)
 *   - website        → "Website" column (URL: artist page link)
 *
 * NOTE: The field IDs above use Wix's auto-generated camelCase format.
 * If your field IDs differ, check them in the CMS > Collection > Fields panel.
 * You can also use the Wix Data API's listDataItems() to inspect actual field keys.
 */
export async function getLineup() {
  const results = await wixData.query("Team")
    .ascending("id")
    .limit(1000)
    .find();

  return results.items
    .filter(item => item["id"] && item["sznpad"]) // Only include items with dates & stages
    .map((item, index) => {
      // Parse stage from the sznpad field (may be array or string)
      let stage = "";
      const rawStage = item["sznpad"];
      if (Array.isArray(rawStage)) {
        stage = rawStage[0] || "";
      } else if (typeof rawStage === "string") {
        try {
          const parsed = JSON.parse(rawStage);
          stage = Array.isArray(parsed) ? parsed[0] || "" : rawStage;
        } catch {
          stage = rawStage;
        }
      }

      const startTime = item["id"];
      const endTime = item["id1"];

      return {
        id: item._id || `artist-${index}`,
        name: item.title || "",
        stage,
        startTime: startTime instanceof Date ? startTime.toISOString() : startTime,
        endTime: endTime instanceof Date ? endTime.toISOString() : endTime,
        genre: item["genre1"] || "",
        url: item["website"] || "",
      };
    });
}
