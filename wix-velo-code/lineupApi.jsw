// ============================================================
// Backend/lineupApi.jsw
// Kolorádó Festival Timetable — Wix Velo Backend Module
// Place this file at: Backend > lineupApi.jsw in the Velo editor
// ============================================================

import wixData from 'wix-data';
import { getImageUrl } from 'wix-media-backend';

/**
 * Fetch all lineup items from the "Team" CMS collection.
 * Returns an array of artist objects formatted for the Custom Element.
 *
 * CMS field IDs (from your Wix Content Manager — "Team" collection):
 *   - title          → Artist name
 *   - photo          → Artist photo (wix:image:// URI — converted to https:// below)
 *   - id             → "Kezdő idő" — start time (Date/Time field)
 *   - id1            → "Vége idő"  — end time (Date/Time field)
 *   - sznpad         → "Színpad"   — stage name (Tags/Reference)
 *   - genre1         → Genre (Text)
 *   - website        → Artist website / Kolorádó artist page URL
 *   - longDescription → Artist bio
 *   - jobTitle       → Nationality
 *   - youtubeLink2   → YouTube link
 *   - newField       → Soundcloud link
 *
 * NOTE: The field IDs above use Wix's auto-generated camelCase format.
 * If your field IDs differ, check them in the CMS > Collection > Fields panel.
 */
export async function getLineup() {
  const results = await wixData.query("Team")
    .ascending("id")
    .limit(1000)
    .find();

  return results.items
    .filter(item => item["id"] && item["sznpad"]) // Only include items with dates & stages
    .map((item, index) => {
      // Parse stage from the sznpad field (may be array or string)
      let stage = "";
      const rawStage = item["sznpad"];
      if (Array.isArray(rawStage)) {
        stage = rawStage[0] || "";
      } else if (typeof rawStage === "string") {
        try {
          const parsed = JSON.parse(rawStage);
          stage = Array.isArray(parsed) ? parsed[0] || "" : rawStage;
        } catch {
          stage = rawStage;
        }
      }

      const startTime = item["id"];
      const endTime = item["id1"];

      // Convert wix:image:// URI to a real public https:// URL.
      // getImageUrl() is only available in the Wix backend (jsw files) — it
      // resolves the proprietary URI to https://static.wixstatic.com/...
      let photoUrl = "";
      if (item["photo"]) {
        try {
          photoUrl = getImageUrl(item["photo"]);
        } catch (e) {
          // Fallback: if the field already contains a plain https:// URL, use it as-is
          photoUrl = item["photo"];
        }
      }

      return {
        id: item._id || `artist-${index}`,
        name: item.title || "",
        photo: photoUrl,
        stage,
        startTime: startTime instanceof Date ? startTime.toISOString() : startTime,
        endTime: endTime instanceof Date ? endTime.toISOString() : endTime,
        genre: item["genre1"] || "",
        url: item["website"] || "",
        bio: item["longDescription"] || "",
        nationality: item["jobTitle"] || "",
        youtube: item["youtubeLink2"] || "",
        soundcloud: item["newField"] || "",
      };
    });
}
