// ============================================================
// Backend/lineupApi.jsw  — v8
// Kolorádó Festival Timetable — Wix Velo Backend Module
//
// Place this file at: Backend > lineupApi.jsw in the Velo editor.
// Both the timetable page and the lineup grid page import from here:
//   import { getLineup } from 'backend/lineupApi';
//
// CMS collection: "Lineup" (internal name: "Team")
// Verified field IDs (from CMS > Fields panel):
//   title           → Artist name
//   photo           → Artist photo  (wix:image:// URI → converted to https://)
//   mainStart       → Kezdő idő     (Date/Time — main slot start)
//   mainEnd         → Vége idő      (Date/Time — main slot end)
//   secondStart     → 2nd slot start (Date/Time)
//   secondEnd       → 2nd slot end   (Date/Time)
//   thirdStart      → 3rd slot start (Date/Time)
//   thirdEnd        → 3rd slot end   (Date/Time)
//   sznpad          → Színpad        (Tags / Array)
//   genre1          → Genre          (Text)
//   longDescription → Long Description (Text)
//   newField        → Soundcloud link  (URL)
//   youtubeLink2    → Youtube link     (URL)
//   audioplayer     → PLAYER           (Audio / URL)
//   jobTitle        → Nationality / Live (Text)
//   website         → Website          (URL)
//   title1          → Subtitle         (Text)
//   programtpus     → Program type     (Tags / Array — note: no 'i' in slug)
// ============================================================

import wixData from 'wix-data';

// Convert wix:image://v1/<hash>/<filename>#... to a real wixstatic.com URL.
function wixImageToUrl(uri) {
  if (!uri) return "";
  if (uri.startsWith("http")) return uri; // already a plain URL
  const match = uri.match(/wix:image:\/\/v1\/([^/]+)\/([^#]+)/);
  if (!match) return "";
  const [, hash, filename] = match;
  return `https://static.wixstatic.com/media/${hash}/v1/fill/w_800,h_800,al_c,q_85/${filename}`;
}

// Safely convert a Date object or ISO string to ISO string, or null if missing.
function toIso(val) {
  if (!val) return null;
  return val instanceof Date ? val.toISOString() : val;
}

export async function getLineup() {
  const results = await wixData.query("Team")
    .ascending("title")   // alphabetical fallback; timetable sorts by startTime
    .limit(1000)
    .find();

  return results.items.map((item, index) => {

    // ── Stage ──────────────────────────────────────────────
    // sznpad may be a plain string, a JSON-encoded array, or an actual array
    let stage = "";
    const rawStage = item.sznpad;
    if (Array.isArray(rawStage)) {
      stage = rawStage[0] || "";
    } else if (typeof rawStage === "string") {
      try {
        const parsed = JSON.parse(rawStage);
        stage = Array.isArray(parsed) ? (parsed[0] || "") : rawStage;
      } catch {
        stage = rawStage;
      }
    }

    // ── Return shape ───────────────────────────────────────
    // Field names here MUST match what kolorado-lineup-v2.js and kolorado-timetable.js expect.
    return {
      // System ID (used as unique key in the lineup grid)
      // Returned as both _id and id so custom elements can use either
      _id:             item._id || `artist-${index}`,
      id:              item._id || `artist-${index}`,
      name:            item.title        || "",
      photo:           wixImageToUrl(item.photo),
      stage,

      // Main slot
      mainStart:       toIso(item.mainStart),
      mainEnd:         toIso(item.mainEnd),

      // Second slot (optional)
      secondStart:     toIso(item.secondStart),
      secondEnd:       toIso(item.secondEnd),

      // Third slot (optional)
      thirdStart:      toIso(item.thirdStart),
      thirdEnd:        toIso(item.thirdEnd),

      // Metadata
      genre:           item.genre1          || "",
      longDescription: item.longDescription || "",
      soundcloudLink:  item.newField        || "",
      youtubeLink:     item.youtubeLink2    || "",
      audioPlayer:     item.audioplayer     || "",
      nationality:     item.jobTitle        || "",
      url:             item.website         || "",
      title1:          item.title1          || "",   // subtitle shown under artist name
      programtipus:    item.programtpus     || "",   // CMS slug has no 'i': programtpus
      timetableonly:   item.timetableonly   || false, // if true: show only in timetable, not lineup
    };
  });
}
