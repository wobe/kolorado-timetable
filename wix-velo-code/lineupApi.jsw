// ============================================================
// Backend/lineupApi.jsw  — v3
// Kolorádó Festival Timetable — Wix Velo Backend Module
//
// Place this file at: Backend > lineupApi.jsw in the Velo editor.
// Both the timetable page and the lineup grid page import from here:
//   import { getLineup } from 'backend/lineupApi';
//
// CMS collection: "Team"
// Field IDs (Wix auto-generated camelCase — check yours in CMS > Fields):
//   title           → Artist name
//   photo           → Artist photo  (wix:image:// URI → converted to https://)
//   id              → Start time    (Date/Time field)
//   id1             → End time      (Date/Time field)
//   sznpad          → Stage name    (Text / Tags)
//   genre1          → Genre         (Text)
//   longDescription → Long bio      (Rich Text / Text)
//   newField        → SoundCloud URL (Text)
//   youtubeLink2    → YouTube URL   (Text)
//   jobTitle        → Nationality   (Text)
//   website         → Artist URL    (Text)
//
// NOTE: If your field IDs differ, update the mapping below.
//       Check them in the CMS > Collection > Fields panel.
// ============================================================

import wixData from 'wix-data';
import { getImageUrl } from 'wix-media-backend';

export async function getLineup() {
  const results = await wixData.query("Team")
    .ascending("title")   // alphabetical fallback; timetable sorts by startTime
    .limit(1000)
    .find();

  return results.items
    .filter(item => item["id"] && item["sznpad"])  // must have a start time and a stage
    .map((item, index) => {

      // ── Stage ──────────────────────────────────────────────
      // sznpad may be a plain string, a JSON-encoded array, or an actual array
      let stage = "";
      const rawStage = item["sznpad"];
      if (Array.isArray(rawStage)) {
        stage = rawStage[0] || "";
      } else if (typeof rawStage === "string") {
        try {
          const parsed = JSON.parse(rawStage);
          stage = Array.isArray(parsed) ? (parsed[0] || "") : rawStage;
        } catch {
          stage = rawStage;
        }
      }

      // ── Times ──────────────────────────────────────────────
      const startTime = item["id"];
      const endTime   = item["id1"];

      // ── Photo ──────────────────────────────────────────────
      // getImageUrl() converts wix:image://v1/... to a real https://static.wixstatic.com/... URL.
      // It is only available in backend (jsw) files.
      // If the field already holds a plain https:// URL (e.g. from an older migration), use it as-is.
      let photo = "";
      if (item["photo"]) {
        try {
          photo = getImageUrl(item["photo"]);
        } catch {
          photo = item["photo"];
        }
      }

      // ── Return shape ───────────────────────────────────────
      // Field names here MUST match what kolorado-lineup.js and kolorado-timetable.js expect.
      return {
        id:              item._id || `artist-${index}`,
        name:            item.title || "",
        photo,                                                    // full https:// URL
        stage,
        startTime:       startTime instanceof Date ? startTime.toISOString() : (startTime || null),
        endTime:         endTime   instanceof Date ? endTime.toISOString()   : (endTime   || null),
        genre:           item["genre1"]          || "",
        longDescription: item["longDescription"] || "",           // popup body text
        soundcloudLink:  item["newField"]        || "",           // SoundCloud embed URL
        youtubeLink:     item["youtubeLink2"]    || "",           // YouTube embed URL
        nationality:     item["jobTitle"]        || "",
        url:             item["website"]         || "",           // Kolorádó artist page path
      };
    });
}
